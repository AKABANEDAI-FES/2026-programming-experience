    "lint": "eslint ."
  },
  "dependencies": {
    "hono": "^4.12.30",
    "shared": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.110.0"
  }
}
