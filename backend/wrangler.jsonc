{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2026-programming-experience",
  // 実行委員会（akabanedai-fes）のアカウント。誰がデプロイしてもこのアカウントに入る
  "account_id": "6a3de6e9787184d885765839de7d30c4",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  // フロントのビルド結果も同じ Worker から配信する（#73）
  "assets": {
    "directory": "../frontend/dist",
    // /display に直接アクセスしても index.html を返す
    "not_found_handling": "single-page-application",
    // API と WebSocket は静的ファイルより先に Worker で処理する
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DISPLAY_ROOM",
        "class_name": "DisplayRoom",
      },
    ],
  },
  "exports": {
    "DisplayRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "2026-programming-experience",
    },
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
